From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mika Ala-Sippola <mika.ala-sippola@outlook.com>
Date: Thu, 1 Oct 2026 21:58:00 +0300
Subject: drm/panel: sitronix-st7701: add support for TJC 480x800 panel

Add support for the Sitronix ST7701-based 480x800 MIPI-DSI panel
(tjc,st7701-480-800) found on the Creality K2 Pro printer.

- Support hardware enable GPIO and reset assertion/deassertion pulse
- Add 55-step factory DCS initialization sequence using DE mode (0xCC = 0x38)
- Modeline timings aligned to factory 58.08 Hz specs
- Set MIPI DSI video mode to SYNC_PULSE

Signed-off-by: Mika Ala-Sippola <mika.ala-sippola@outlook.com>
---
--- a/drivers/gpu/drm/panel/panel-sitronix-st7701.c
+++ b/drivers/gpu/drm/panel/panel-sitronix-st7701.c
@@ -127,6 +127,9 @@
 
 	/* GIP sequence, fully custom and undocumented. */
 	void		(*gip_sequence)(struct st7701 *st7701);
+
+	/* Full initialization sequence, bypassing generic sequence */
+	void		(*init_sequence)(struct st7701 *st7701);
 };
 
 struct st7701 {
@@ -137,6 +140,7 @@
 
 	struct regulator_bulk_data supplies[2];
 	struct gpio_desc *reset;
+	struct gpio_desc *enable;
 	unsigned int sleep_delay;
 	enum drm_panel_orientation orientation;
 
@@ -547,7 +551,14 @@
 	struct st7701 *st7701 = panel_to_st7701(panel);
 	int ret;
 
-	gpiod_set_value(st7701->reset, 0);
+	if (st7701->enable) {
+		gpiod_set_value_cansleep(st7701->enable, 1);
+		msleep(50);
+		gpiod_set_value_cansleep(st7701->enable, 0);
+		msleep(50);
+		gpiod_set_value_cansleep(st7701->enable, 1);
+		msleep(20);
+	}
 
 	ret = regulator_bulk_enable(ARRAY_SIZE(st7701->supplies),
 				    st7701->supplies);
@@ -555,16 +566,23 @@
 		return ret;
 	msleep(20);
 
+	/* Reset pulse: Assert (LOW) -> Deassert (HIGH) */
 	gpiod_set_value(st7701->reset, 1);
+	msleep(30);
+	gpiod_set_value(st7701->reset, 0);
 	msleep(150);
 
-	st7701_init_sequence(st7701);
-
-	if (st7701->desc->gip_sequence)
-		st7701->desc->gip_sequence(st7701);
-
-	/* Disable Command2 */
-	st7701_switch_cmd_bkx(st7701, false, 0);
+	if (st7701->desc->init_sequence) {
+		st7701->desc->init_sequence(st7701);
+	} else {
+		st7701_init_sequence(st7701);
+
+		if (st7701->desc->gip_sequence)
+			st7701->desc->gip_sequence(st7701);
+
+		/* Disable Command2 */
+		st7701_switch_cmd_bkx(st7701, false, 0);
+	}
 
 	return 0;
 }
@@ -609,6 +627,9 @@
 	msleep(st7701->sleep_delay);
 
 	regulator_bulk_disable(ARRAY_SIZE(st7701->supplies), st7701->supplies);
+
+	if (st7701->enable)
+		gpiod_set_value_cansleep(st7701->enable, 0);
 
 	return 0;
 }
@@ -1157,6 +1178,129 @@
 	.gip_sequence = rg28xx_gip_sequence,
 };
 
+static const struct drm_display_mode tjc_480_800_mode = {
+	.clock		= 25000,
+
+	.hdisplay	= 480,
+	.hsync_start	= 480 + 10,
+	.hsync_end	= 480 + 10 + 10,
+	.htotal		= 510,
+
+	.vdisplay	= 800,
+	.vsync_start	= 800 + 20,
+	.vsync_end	= 800 + 20 + 4,
+	.vtotal		= 844,
+
+	.width_mm	= 52,
+	.height_mm	= 86,
+
+	.flags		= DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static void tjc_480_800_init_sequence(struct st7701 *st7701)
+{
+	/* Step 00: Delay 10ms */
+	msleep(10);
+
+	/* Step 01: Soft Reset */
+	ST7701_WRITE(st7701, MIPI_DCS_SOFT_RESET, 0x00);
+
+	/* Step 02: Delay 120ms */
+	msleep(120);
+
+	/* Step 03-04: Unlock Command2 BK3 */
+	st7701_switch_cmd_bkx(st7701, true, 3);
+	ST7701_WRITE(st7701, 0xEF, 0x08);
+
+	/* Step 05-09: Command2 BK0 */
+	st7701_switch_cmd_bkx(st7701, true, 0);
+	ST7701_WRITE(st7701, 0xC0, 0x63, 0x00);
+	ST7701_WRITE(st7701, 0xC1, 0x0A, 0x02);
+	ST7701_WRITE(st7701, 0xC2, 0x01, 0x07);
+	ST7701_WRITE(st7701, 0xCC, 0x38);
+
+	/* Step 10-11: BK0 Gamma */
+	ST7701_WRITE(st7701, 0xB0, 0x05, 0x10, 0x16, 0x0D, 0x10, 0x06, 0x07, 0x08,
+		     0x08, 0x25, 0x06, 0x13, 0x11, 0x29, 0x31, 0x18);
+	ST7701_WRITE(st7701, 0xB1, 0x05, 0x0F, 0x16, 0x0D, 0x10, 0x06, 0x07, 0x09,
+		     0x08, 0x25, 0x05, 0x14, 0x12, 0x29, 0x30, 0x18);
+
+	/* Step 12-25: Command2 BK1 */
+	st7701_switch_cmd_bkx(st7701, true, 1);
+	ST7701_WRITE(st7701, 0xB0, 0x5D);
+	ST7701_WRITE(st7701, 0xB1, 0x49);
+	ST7701_WRITE(st7701, 0xB2, 0x82);
+	ST7701_WRITE(st7701, 0xB3, 0x80);
+	ST7701_WRITE(st7701, 0xB5, 0x45);
+	ST7701_WRITE(st7701, 0xB7, 0x85);
+	ST7701_WRITE(st7701, 0xB8, 0x21);
+	ST7701_WRITE(st7701, 0xB9, 0x10, 0x1F);
+	ST7701_WRITE(st7701, 0xBB, 0x03);
+	ST7701_WRITE(st7701, 0xBC, 0x3E);
+	ST7701_WRITE(st7701, 0xC1, 0x78);
+	ST7701_WRITE(st7701, 0xC2, 0x78);
+	ST7701_WRITE(st7701, 0xD0, 0x88);
+
+	/* Step 26: Delay 30ms */
+	msleep(30);
+
+	/* Step 27-39: BK1 GIP */
+	ST7701_WRITE(st7701, 0xE0, 0x00, 0x00, 0x02);
+	ST7701_WRITE(st7701, 0xE1, 0x04, 0x00, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00,
+		     0x00, 0x20, 0x20);
+	ST7701_WRITE(st7701, 0xE2, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+		     0x00, 0x00, 0x00, 0x00);
+	ST7701_WRITE(st7701, 0xE3, 0x00, 0x00, 0x33, 0x00);
+	ST7701_WRITE(st7701, 0xE4, 0x22, 0x00);
+	ST7701_WRITE(st7701, 0xE5, 0x04, 0x34, 0x9A, 0xA0, 0x06, 0x34, 0x9A, 0xA0,
+		     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+	ST7701_WRITE(st7701, 0xE6, 0x00, 0x00, 0x33, 0x00);
+	ST7701_WRITE(st7701, 0xE7, 0x22, 0x00);
+	ST7701_WRITE(st7701, 0xE8, 0x05, 0x34, 0x9A, 0xA0, 0x07, 0x34, 0x9A, 0xA0,
+		     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+	ST7701_WRITE(st7701, 0xEB, 0x02, 0x00, 0x40, 0x40, 0x00, 0x00, 0x00);
+	ST7701_WRITE(st7701, 0xEC, 0x00, 0x00);
+	ST7701_WRITE(st7701, 0xED, 0xFA, 0x45, 0x0B, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
+		     0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xB0, 0x54, 0xAF);
+	ST7701_WRITE(st7701, 0xEF, 0x08, 0x08, 0x08, 0x45, 0x3F, 0x54);
+
+	/* Step 40-41: BK3 power calibration */
+	st7701_switch_cmd_bkx(st7701, true, 3);
+	ST7701_WRITE(st7701, 0xE8, 0x00, 0x0E);
+
+	/* Step 42-44: Disable Command2, Exit sleep, delay 40ms */
+	st7701_switch_cmd_bkx(st7701, false, 0);
+	ST7701_WRITE(st7701, MIPI_DCS_EXIT_SLEEP_MODE, 0x00);
+	msleep(40);
+
+	/* Step 45-48: BK3 calibration step 2, delay 10ms */
+	st7701_switch_cmd_bkx(st7701, true, 3);
+	ST7701_WRITE(st7701, 0xE8, 0x00, 0x0C);
+	msleep(10);
+	ST7701_WRITE(st7701, 0xE8, 0x00, 0x00);
+
+	/* Step 49-51: Disable Command2, Exit sleep, delay 120ms */
+	st7701_switch_cmd_bkx(st7701, false, 0);
+	ST7701_WRITE(st7701, MIPI_DCS_EXIT_SLEEP_MODE, 0x00);
+	msleep(120);
+
+	/* Step 52-55: MADCTL, COLMOD, Display On, delay 20ms */
+	ST7701_WRITE(st7701, MIPI_DCS_SET_ADDRESS_MODE, 0x00);
+	ST7701_WRITE(st7701, MIPI_DCS_SET_PIXEL_FORMAT, 0x77);
+	ST7701_WRITE(st7701, MIPI_DCS_SET_DISPLAY_ON, 0x00);
+	msleep(20);
+}
+
+static const struct st7701_panel_desc tjc_480_800_desc = {
+	.mode = &tjc_480_800_mode,
+	.lanes = 2,
+	.format = MIPI_DSI_FMT_RGB888,
+	.panel_sleep_delay = 0,
+	.init_sequence = tjc_480_800_init_sequence,
+};
+
 static const struct drm_display_mode wf40eswaa6mnn0_mode = {
 	.clock		= 18306,
 
@@ -1296,6 +1440,12 @@
 		return PTR_ERR(st7701->reset);
 	}
 
+	st7701->enable = devm_gpiod_get_optional(dev, "enable", GPIOD_OUT_HIGH);
+	if (IS_ERR(st7701->enable)) {
+		dev_err(dev, "Couldn't get our enable GPIO\n");
+		return PTR_ERR(st7701->enable);
+	}
+
 	ret = of_drm_get_panel_orientation(dev->of_node, &st7701->orientation);
 	if (ret < 0)
 		return dev_err_probe(dev, ret, "Failed to get orientation\n");
@@ -1341,8 +1491,8 @@
 	if (!st7701->desc->lanes)
 		return dev_err_probe(&dsi->dev, -EINVAL, "This panel is not for MIPI DSI\n");
 
-	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
-			  MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_MODE_LPM;
 	dsi->format = st7701->desc->format;
 	dsi->lanes = st7701->desc->lanes;
 
@@ -1388,6 +1538,7 @@
 	{ .compatible = "densitron,dmt028vghmcmi-1a", .data = &dmt028vghmcmi_1a_desc },
 	{ .compatible = "elida,kd50t048a", .data = &kd50t048a_desc },
 	{ .compatible = "techstar,ts8550b", .data = &ts8550b_desc },
+	{ .compatible = "tjc,st7701-480-800", .data = &tjc_480_800_desc },
 	{ .compatible = "winstar,wf40eswaa6mnn0", .data = &wf40eswaa6mnn0_desc },
 	{ }
 };

